diff --git a/src/llama-bench-memory.cpp b/src/llama-bench-memory.cpp
new file mode 100644
index 000000000..15045b44b
--- /dev/null
+++ b/src/llama-bench-memory.cpp
@@ -0,0 +1,154 @@
+#include "llama-bench-memory.h"
+#include "llama-context.h"
+#include "llama-memory-hybrid.h"
+#include "llama-memory-recurrent.h"
+#include "../vendor/nlohmann/json.hpp"
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <unordered_map>
+#if defined(__APPLE__)
+#include <mach/mach.h>
+#endif
+#if defined(_WIN32)
+#include <process.h>
+#define bench_getpid _getpid
+#else
+#include <unistd.h>
+#define bench_getpid getpid
+#endif
+
+using json = nlohmann::ordered_json;
+using clock_type = std::chrono::steady_clock;
+namespace {
+struct context_record { uint64_t id; clock_type::time_point last{}; };
+struct observer {
+    FILE * file = nullptr;
+    uint64_t next = 1, sequence = 0;
+    bool failed = false;
+    uint64_t observer_ns = 0;
+    clock_type::time_point flushed{};
+    std::mutex mutex;
+    std::unordered_map<llama_context *, context_record> contexts;
+    observer() {
+        const char * path = std::getenv("LLAMA_BENCH_MEMORY_LOG");
+        if (path && *path) {
+            file = std::fopen(path, "a");
+            if (file) std::setvbuf(file, nullptr, _IOFBF, 65536);
+            if (!file) { failed = true; std::fprintf(stderr, "memory telemetry: cannot open %s\n", path); }
+        }
+    }
+    ~observer() { if (file) std::fclose(file); }
+    void write(json record) {
+        record["schema"] = "llama.memory.v1";
+        record["pid"] = bench_getpid();
+        record["seq"] = ++sequence;
+        record["steadyNs"] = std::chrono::duration_cast<std::chrono::nanoseconds>(clock_type::now().time_since_epoch()).count();
+        record["unixMs"] = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+        const std::string line = record.dump() + "\n";
+        const auto now = clock_type::now();
+        bool bad = std::fwrite(line.data(), 1, line.size(), file) != line.size();
+        if (now-flushed >= std::chrono::milliseconds(250)) { bad = bad || std::fflush(file); flushed=now; }
+        if (bad) {
+            failed = true;
+            std::fprintf(stderr, "memory telemetry: write failed\n");
+        }
+    }
+};
+observer & sink() { static observer value; return value; }
+json counts(const llama_bench_cell_counts & c) {
+    return {{"capacityCells",c.capacity},{"occupiedCells",c.used},{"sharedCells",c.shared},
+            {"sequenceReferences",c.references},{"residentSequences",c.sequences}};
+}
+json buffers(const llama_memory_i * mem) {
+    auto rows = json::array();
+    for (const auto & entry : mem->memory_breakdown()) {
+        rows.push_back({{"bufferType",ggml_backend_buft_name(entry.first)},{"bytes",entry.second}});
+    }
+    return rows;
+}
+json recurrent(const llama_memory_recurrent * mem) {
+    uint64_t used = 0, shared = 0, refs = 0;
+    std::set<llama_seq_id> sequences;
+    for (const auto & cell : mem->cells) {
+        if (cell.seq_id.empty()) continue;
+        ++used; refs += cell.seq_id.size(); shared += cell.seq_id.size() > 1;
+        sequences.insert(cell.seq_id.begin(), cell.seq_id.end());
+    }
+    return {{"capacityStateRows",mem->size},{"occupiedStateRows",used},{"sharedStateRows",shared},
+            {"sequenceReferences",refs},{"residentSequences",sequences.size()},
+            {"rollbackSnapshotsPerSequence",mem->n_rs_seq},{"allocation",buffers(mem)}};
+}
+json attention(const llama_kv_cache * mem) {
+    auto rows = json::array();
+    for (const auto & c : mem->benchmark_cells()) rows.push_back(counts(c));
+    return {{"streams",rows},{"poolIdentity",mem->benchmark_pool_id()},{"allocation",buffers(mem)}, {"typeK",ggml_type_name(mem->type_k())},
+            {"typeV",ggml_type_name(mem->type_v())}};
+}
+json process_memory() {
+#if defined(__APPLE__)
+    task_vm_info_data_t info{};
+    mach_msg_type_number_t n = TASK_VM_INFO_COUNT;
+    if (task_info(mach_task_self(), TASK_VM_INFO, reinterpret_cast<task_info_t>(&info), &n) == KERN_SUCCESS)
+        return {{"source","mach.task_vm_info"},{"physicalFootprintBytes",info.phys_footprint},
+                {"residentBytes",info.resident_size},{"compressedBytes",info.compressed}};
+#endif
+    return nullptr;
+}
+void snapshot(observer & s, llama_context * ctx, const char * event, bool force) {
+    auto inserted = s.contexts.emplace(ctx, context_record{s.next,{}});
+    if (inserted.second) ++s.next;
+    auto & record = inserted.first->second;
+    const auto now = clock_type::now();
+    if (!force && now-record.last < std::chrono::milliseconds(250)) return;
+    record.last = now;
+    const auto start = clock_type::now();
+    json result = {{"event",event},{"contextId",record.id},{"nCtx",ctx->n_ctx()},
+                   {"nSeqMax",ctx->n_seq_max()},{"nCtxPerSequence",ctx->n_ctx_seq()},
+                   {"nBatch",ctx->n_batch()},{"nUbatch",ctx->n_ubatch()},
+                   {"modelIdentity",reinterpret_cast<uintptr_t>(&ctx->get_model())},
+                   {"attention",nullptr},{"recurrent",nullptr}};
+    auto allocation = json::array();
+    for (const auto & entry : ctx->memory_breakdown()) {
+        allocation.push_back({{"bufferType",ggml_backend_buft_name(entry.first)},
+                              {"modelBytes",entry.second.model},{"contextBytes",entry.second.context},
+                              {"computeBytes",entry.second.compute}});
+    }
+    result["allocation"] = allocation;
+    auto * memory = ctx->get_memory();
+    if (auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory)) {
+        result["attention"] = attention(hybrid->get_mem_attn());
+        result["recurrent"] = recurrent(hybrid->get_mem_recr());
+    } else if (auto * kv = dynamic_cast<llama_kv_cache *>(memory)) {
+        result["attention"] = attention(kv);
+    } else if (auto * rec = dynamic_cast<llama_memory_recurrent *>(memory)) {
+        result["recurrent"] = recurrent(rec);
+    }
+    result["occupancySupported"] = !result["attention"].is_null() || !result["recurrent"].is_null();
+    result["processMemory"] = process_memory();
+    result["collectionNs"] = std::chrono::duration_cast<std::chrono::nanoseconds>(clock_type::now()-start).count();
+    result["priorObserverNs"] = s.observer_ns;
+    s.write(result);
+    s.observer_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(clock_type::now()-start).count();
+}
+}
+void llama_bench_context(llama_context * ctx, const char * event, bool force) noexcept {
+    try { auto & s=sink(); if (!s.file || s.failed) return; std::lock_guard<std::mutex> lock(s.mutex); snapshot(s,ctx,event,force); }
+    catch (...) { std::fprintf(stderr,"memory telemetry: sample failed\n"); }
+}
+void llama_bench_memory(llama_memory_t mem, const char * event) noexcept {
+    try { auto & s=sink(); if (!s.file || s.failed) return; std::lock_guard<std::mutex> lock(s.mutex);
+        for (const auto & item : s.contexts) if (item.first->get_memory()==mem) { snapshot(s,item.first,event,true); break; }
+    } catch (...) { std::fprintf(stderr,"memory telemetry: mutation sample failed\n"); }
+}
+void llama_bench_forget(llama_context * ctx) noexcept {
+    try { auto & s=sink(); if (!s.file || s.failed) return; std::lock_guard<std::mutex> lock(s.mutex);
+        auto it=s.contexts.find(ctx); if(it!=s.contexts.end()) { s.write({{"event","context.destroy"},{"contextId",it->second.id},{"observerTotalNs",s.observer_ns}}); s.contexts.erase(it); }
+    } catch (...) { std::fprintf(stderr,"memory telemetry: close failed\n"); }
+}
+void llama_bench_cache(const char * event, uint64_t bytes, uint64_t states, uint64_t tokens, uint64_t limit) noexcept {
+    try { auto & s=sink(); if (!s.file || s.failed) return; std::lock_guard<std::mutex> lock(s.mutex);
+        s.write({{"event",event},{"cacheBytes",bytes},{"cacheEntries",states},{"cacheTokens",tokens},{"cacheLimitBytes",limit}});
+    } catch (...) { std::fprintf(stderr,"memory telemetry: cache sample failed\n"); }
+}
diff --git a/src/llama-bench-memory.h b/src/llama-bench-memory.h
new file mode 100644
index 000000000..61fffbd8b
--- /dev/null
+++ b/src/llama-bench-memory.h
@@ -0,0 +1,13 @@
+#pragma once
+#include "llama.h"
+#include <cstdint>
+
+struct llama_bench_cell_counts {
+    uint64_t capacity = 0, used = 0, shared = 0, references = 0, sequences = 0;
+};
+
+void llama_bench_context(llama_context * ctx, const char * event, bool force = false) noexcept;
+void llama_bench_forget(llama_context * ctx) noexcept;
+void llama_bench_memory(llama_memory_t mem, const char * event) noexcept;
+LLAMA_API void llama_bench_cache(const char * event, uint64_t bytes, uint64_t states,
+                                uint64_t tokens, uint64_t limit) noexcept;
